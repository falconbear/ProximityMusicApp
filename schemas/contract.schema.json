{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/falconbear/claude-harness-dev/schemas/contract.schema.json",
  "title": "Issue Contract",
  "description": "Immutable contract between generator and evaluator. Drafted by generator, approved by evaluator. Locked after CONTRACT_APPROVED.",
  "type": "object",
  "required": [
    "schema_version",
    "issue_id",
    "status",
    "scope",
    "out_of_scope",
    "success_criteria",
    "test_plan",
    "revision_history"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "issue_id": { "type": "string", "pattern": "^[0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "rejected"]
    },
    "locked": {
      "type": "boolean",
      "description": "True after status=approved. Enforced by hooks/contract_immutability_hook.py."
    },
    "approved_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "approved_by": {
      "type": ["string", "null"],
      "enum": ["evaluator", "human", null]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "test_plan": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Concrete, executable test steps for evaluator."
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt", "status", "at"],
        "additionalProperties": false,
        "properties": {
          "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
          "status": { "type": "string", "enum": ["drafted", "rejected", "approved"] },
          "at": { "type": "string", "format": "date-time" },
          "by": {
            "type": ["string", "null"],
            "enum": ["generator", "evaluator", "human", null]
          },
          "feedback_ref": {
            "type": ["string", "null"],
            "description": "Relative path to feedback MD file."
          }
        }
      }
    }
  }
}
